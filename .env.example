# =============================================================================
# FathersNet (Ayay) — local environment template
# Copy to `.env` for local development (Docker Compose reads it; `.env` is
# gitignored). NEVER commit real secret values (engineering-standards.md §16).
# This file documents the canonical variable set — the central registry lives
# in packages/config (engineering-standards.md §18). Naming: FN_* for app vars,
# UPPER_SNAKE_CASE domain prefixes per §18; `ENV` is dev|staging|prod and is
# never overridden at runtime (§18, NFR-036).
# =============================================================================

# --- Runtime environment (12-factor) ---
ENV=dev
NODE_ENV=development
LOG_LEVEL=info

# --- Application config (FN_* registry in packages/config) ---
FN_APP_NAME=fathersnet
FN_SERVICE_NAME=gateway
FN_PORT=3000
FN_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
FN_REQUEST_ID_HEADER=X-Request-Id
FN_HEALTH_PREFIX=/healthz
FN_REDIS_URL=redis://127.0.0.1:6379
FN_STORE_DRIVER=memory
FN_RATE_LIMIT_DEFAULT=120
FN_RATE_LIMIT_AI=30
FN_RATE_LIMIT_ADMIN_EXPORT=10
FN_RATE_LIMIT_WINDOW_SECONDS=60
FN_IDEMPOTENCY_TTL_SECONDS=86400

# --- Auth service (WP-016; services/auth config) ---
# FN_AUTH_JWT_SECRET signs/verifies access JWTs. REQUIRED for the auth service
# (fails fast at boot); the gateway only validates tokens when this is set
# (otherwise Bearer tokens pass through). Never commit a real secret.
FN_AUTH_JWT_SECRET=
FN_AUTH_ISSUER=fathersnet
FN_AUTH_AUDIENCE=fathersnet-api
FN_AUTH_ACCESS_TTL_SECONDS=900
FN_AUTH_REFRESH_TTL_SECONDS=2592000
FN_AUTH_OTP_TTL_SECONDS=300
FN_AUTH_OTP_LENGTH=6
FN_AUTH_OTP_MAX_REQUESTS=5
FN_AUTH_OTP_REQUEST_WINDOW_SECONDS=900
FN_AUTH_OTP_MAX_ATTEMPTS=5
FN_AUTH_OTP_LOCKOUT_SECONDS=900

# --- Users service (WP-017; services/users config) ---
# FN_USERS_JWT_SECRET must equal FN_AUTH_JWT_SECRET (shared WP-016 HS256 secret)
# so the users service can verify access tokens. FN_USERS_PHONE_ENC_KEY /
# FN_USERS_PHONE_DIGEST_KEY are REQUIRED: they encrypt the phone at rest and
# key the lookup digest (05 §8.1, FR-009/FR-123). Never commit real secrets.
FN_USERS_JWT_SECRET=
FN_USERS_ISSUER=fathersnet
FN_USERS_AUDIENCE=fathersnet-api
FN_USERS_PHONE_ENC_KEY=
FN_USERS_PHONE_DIGEST_KEY=

# --- Content service (WP-020; services/content config) ---
# FN_CONTENT_JWT_SECRET must equal FN_AUTH_JWT_SECRET (shared WP-016 HS256
# secret) so the content service can verify access tokens. REQUIRED (fails
# fast at boot). Never commit a real secret.
FN_CONTENT_JWT_SECRET=
FN_CONTENT_ISSUER=fathersnet
FN_CONTENT_AUDIENCE=fathersnet-api
FN_CONTENT_PORT=3300
FN_STORE_DRIVER=memory

# --- Reminders service (WP-021; services/reminders config) ---
# FN_REMINDERS_JWT_SECRET must equal FN_AUTH_JWT_SECRET (shared WP-016 HS256
# secret) so the reminders service can verify access tokens. REQUIRED (fails
# fast at boot). Never commit a real secret.
# `memory` keeps local dev hermetic; production uses `postgres` (the scheduler
# host also runs the reminders job and self-configures from the same vars,
# WP-021 risk R3).
FN_REMINDERS_JWT_SECRET=
FN_REMINDERS_ISSUER=fathersnet
FN_REMINDERS_AUDIENCE=fathersnet-api
FN_STORE_DRIVER=memory
FN_REMINDERS_DAILY_CAP=5
FN_REMINDERS_TZ_OFFSET_MINUTES=180
FN_REMINDERS_QUIET_HOURS_ENABLED=true
FN_REMINDERS_QUIET_HOURS_START=21:00
FN_REMINDERS_QUIET_HOURS_END=07:00
FN_REMINDERS_EXPIRY_MINUTES=60
FN_REMINDERS_JOB_INTERVAL_SECONDS=60
FN_REMINDERS_DISPATCH_BATCH_LIMIT=100
FN_REMINDERS_MAX_WEEK=45

# --- Journal service (WP-022; services/journal config) ---
# FN_JOURNAL_JWT_SECRET must equal FN_AUTH_JWT_SECRET (shared WP-016 HS256
# secret) so the journal service can verify access tokens. REQUIRED (fails
# fast at boot). Never commit a real secret.
# `memory` keeps local dev hermetic (M-08); production uses `postgres` — the
# Postgres driver also enables best-effort `journal.entry.created` publishing
# over the compose Redis (memory mode keeps the bus in-memory).
FN_JOURNAL_JWT_SECRET=
FN_JOURNAL_ISSUER=fathersnet
FN_JOURNAL_AUDIENCE=fathersnet-api
FN_JOURNAL_PORT=3700
FN_JOURNAL_PAGE_SIZE=20
FN_JOURNAL_MAX_CONTENT_LENGTH=10000

# --- Scheduler service (WP-024b; services/scheduler config) ---
# Redis-only scheduler state: leader election, run-id binding (FR-163), DLQ.
# `memory` keeps dev/CI hermetic (M-08); production uses `redis`.
FN_SCHEDULER_DRIVER=memory
FN_SCHEDULER_LEADER_LEASE_MS=10000
FN_SCHEDULER_TICK_MS=1000
FN_SCHEDULER_RUN_TTL_SECONDS=900
FN_SCHEDULER_RETRY_ATTEMPTS=3
FN_SCHEDULER_RETRY_BASE_MS=500
FN_SCHEDULER_RETRY_MAX_MS=5000
FN_SCHEDULER_RETRY_JITTER=0.2

# --- SRS §16.1 / compose contract (configurable; `12` §2.5) ---
# Values below are local-development placeholders only. In dev/staging/prod,
# secrets are injected from the managed secret manager (M-01) via IaC
# (FR-170, NFR-022). Never put real credentials in `.env`.
DB_PASSWORD=local-dev-only
WHATSAPP_PROVIDER=meta
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
LLM_API_KEY=
ASR_API_KEY=
N8N_USER=admin
N8N_PASSWORD=local-dev-only
BACKUP_RETENTION_DAYS=14

# --- Feature flags (FR-168; config-source bootstrap surface) ---
FEATURE_FLAGS=offline-journal=true,chat-v2=false
