{
  "name": "@fathersnet/test-utils",
  "version": "0.1.0",
  "private": true,
  "description": "Shared test helpers and mock factories (engineering-standards.md §7)",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "sast": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@fathersnet/logger": "*"
  }
}
