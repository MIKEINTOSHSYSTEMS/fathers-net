{
  "name": "@fathersnet/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "FathersNet gateway — Fastify HTTP entry point (Milestone 1: health endpoints only)",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "sast": "eslint \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@fathersnet/config": "*",
    "@fathersnet/errors": "*",
    "@fathersnet/logger": "*",
    "fastify": "5.11.2"
  },
  "devDependencies": {
    "@fathersnet/test-utils": "*"
  }
}
